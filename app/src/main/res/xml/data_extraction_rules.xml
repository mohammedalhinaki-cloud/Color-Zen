<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (android:dataExtractionRules). Same single preference file, for
  both cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="file"
            path="shared_prefs/colorzen_player.xml" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="shared_prefs/colorzen_player.xml" />
    </device-transfer>
</data-extraction-rules>
