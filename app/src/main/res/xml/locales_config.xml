<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-app language support (Android 13+). Lists the bundled translations so the
  system Settings > Apps > Language picker offers them and the app shows the
  correct flag/label. `en` is the default (values/), `ar` is values-ar/.
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="ar" />
</locale-config>
