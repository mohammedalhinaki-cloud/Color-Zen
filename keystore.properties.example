# Copy this file to `keystore.properties` (git-ignored) and fill in real values.
#
# Generate an upload key once, and back it up somewhere safe - losing it means
# you can never publish an update to the same Play listing again:
#
#   keytool -genkeypair -v \
#     -keystore colorzen-upload.jks \
#     -keyalg RSA -keysize 2048 -validity 10000 \
#     -alias colorzen
#
# If you enrol in Play App Signing (recommended, and the default for new apps)
# this key is only the *upload* key; Google holds the signing key.

storeFile=../colorzen-upload.jks
storePassword=CHANGE_ME
keyAlias=colorzen
keyPassword=CHANGE_ME
